<Bindings>
  <Binding name="NOCK_NOTES" header="NOCK">
    Nock_ToggleNotes()
  </Binding>
  <Binding name="NOCK_WINDOW">
    Nock_ToggleWindow()
  </Binding>
  <Binding name="NOCK_STYLE">
    Nock_ToggleStyle()
  </Binding>
  <Binding name="NOCK_THREAT_UNLOCK">
    Nock_ToggleThreatUnlock()
  </Binding>
  <Binding name="NOCK_PINS">
    Nock_TogglePins()
  </Binding>
  <Binding name="NOCK_QUIVER">
    Nock_ToggleQuiver()
  </Binding>
  <Binding name="CLICK NockWingClipButton:LeftButton">
  </Binding>
  <Binding name="CLICK NockMarkButton:LeftButton">
  </Binding>
  <Binding name="CLICK NockFeedButton:LeftButton">
  </Binding>
  <Binding name="NOCK_KIT">
    Nock_OpenKit()
  </Binding>
  <Binding name="NOCK_SUPPLIES">
    Nock_SupplyCheck()
  </Binding>
  <Binding name="NOCK_TRAIN">
    Nock_TrainCheck()
  </Binding>
  <Binding name="NOCK_TAME_PINS">
    Nock_ToggleTamePins()
  </Binding>
  <Binding name="NOCK_TRACKER">
    Nock_ToggleTracker()
  </Binding>
  <Binding name="NOCK_UNLOCK">
    Nock_ToggleUnlock()
  </Binding>
  <Binding name="NOCK_TEST_ALERTS">
    if Nock_TestAlerts then Nock_TestAlerts() end
  </Binding>
  <Binding name="NOCK_MUTE_TOOLS">
    Nock_MuteTools()
  </Binding>
</Bindings>
